           fhir:l <http://hl7.org/fhir/tools/StructureDefinition/resource-information>
         ] ;
         fhir:value [
           a fhir:String ;
           fhir:v "Bundle"
         ]
       ] ) ;
       fhir:reference [
         fhir:l <http://hl7.org/fhir/us/healthedata1-sandbox/Bundle/docref-example-1> ;
         fhir:reference [ fhir:v "Bundle/docref-example-1" ]
       ] ;
       fhir:name [ fhir:v "Docref Example 1" ] ;
       fhir:description [ fhir:v "This bundle is a the response to a $docref operation and contains an example *US Core DocumentReference*.  It is used in [Example 1: Request the latest CCD](StructureDefinition-us-core-documentreference.html#mandatory-operation)." ] ;
       fhir:example [
         a fhir:Boolean ;
         fhir:v true
       ]
     ] [
       fhir:extension ( [
         fhir:url [
           fhir:v "http://hl7.org/fhir/tools/StructureDefinition/resource-information"^^xsd:anyURI ;
           fhir:l <http://hl7.org/fhir/tools/StructureDefinition/resource-information>
         ] ;
